# Copiar a .env y ajustar. NO subir .env al repositorio.

# Base de datos (SQLAlchemy). Ejemplos:
#   local rápido:  sqlite+pysqlite:///./aulaplus.db
#   Docker:        postgresql+psycopg://aulaplus:cambia-esto@db:5432/aulaplus
DATABASE_URL=sqlite+pysqlite:///./aulaplus.db

# Credenciales del contenedor de PostgreSQL (solo para docker compose)
POSTGRES_USER=aulaplus
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=aulaplus

# Cargar los CSV de datos/ si la base está vacía
SEED_DATOS=true

# Estudiantes cuyo pago se rechaza en la pasarela simulada (demo de US-03)
PASARELA_RECHAZAR=AUL-C040

# Nombre del entorno que muestra /salud
APP_ENV=desarrollo
